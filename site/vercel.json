{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
        {"key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"}
      ]
    }
  ],
  "redirects": [
    { "source": "/install.sh", "destination": "https://raw.githubusercontent.com/edgetr/petal/main/get.sh", "permanent": false },
    { "source": "/download/mac", "destination": "https://github.com/edgetr/petal/releases/download/macos-v2.1.4/Petal-2.1.4-macos.zip", "permanent": false },
    { "source": "/github", "destination": "https://github.com/edgetr/petal", "permanent": false }
  ]
}
