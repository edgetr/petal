#!/usr/bin/env bash
# petal: control the Petal dock from a terminal (or from an agent).
set -euo pipefail
config="$HOME/.config/petal"

# Petal for macOS: its own commands (one dock, no modes), sent to the running Petal over its socket.
if [[ $(uname) == Darwin ]]; then
  ipc() {
    local json="[" sep="" arg
    for arg in "$@"; do arg=${arg//\\/\\\\}; arg=${arg//\"/\\\"}; json+="$sep\"$arg\""; sep=","; done
    printf '%s]\n' "$json" | nc -U "$config/petal.sock" || echo "Petal isn't running" >&2
  }
  case "${1:-help}" in
    ask|search|settings|restart|version|reveal) ipc "$1" ;;
    chat)     shift; ipc chat "$*" ;;
    dock)     ipc dock "${2:-}" ;;
    update)   ipc update ;;
    doctor|report|apps|get|set)
      app="/Applications/Petal.app/Contents/MacOS/Petal"
      [[ -x $app ]] || app="$(dirname "$(readlink -f "$0")")/../macos/build/Petal.app/Contents/MacOS/Petal"
      exec "$app" "$@" ;;
    restore-dock)
      # Gives macOS's Dock back even if Petal crashed or was deleted.
      if pgrep -xq Petal; then ipc dock macos
      elif [[ -x /Applications/Petal.app/Contents/MacOS/Petal ]]; then /Applications/Petal.app/Contents/MacOS/Petal --restore-dock
      else defaults write com.apple.dock autohide -bool false; defaults delete com.apple.dock autohide-delay 2>/dev/null; defaults delete com.apple.dock no-bouncing 2>/dev/null; killall Dock; fi ;;
    edit)     open -t "$config/dock.json" ;;
    logs)     log show --last 30m --style compact --predicate 'process == "Petal"' 2>/dev/null | tail -n "${2:-40}" ;;
    *)
      cat <<'HELP'
petal apps            the dock's apps, in the order they show
petal ask             open the Claude panel
petal chat <text>     ask Claude something
petal search          open the add-apps search
petal settings        open Petal's settings
petal dock [petal|macos]  which dock is showing, or switch
petal edit            edit ~/.config/petal/dock.json
petal restart         restart Petal
petal update          check for a new Petal now
petal restore-dock    give macOS's Dock back, even if Petal crashed or was deleted
petal doctor          check Petal (--fix repairs what it safely can)
petal report "…"      tell Petal's maker what went wrong (a GitHub issue; shown to you first)
petal version         the running version
petal logs [n]        recent Petal log lines
HELP
      ;;
  esac
  exit 0
fi

case "${1:-help}" in
  mode)     omarchy-shell petal mode "${2:?usage: petal mode <id>}" ;;
  stay)     omarchy-shell petal stay ;;
  current)  omarchy-shell petal current ;;
  modes)    python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); [print(m["id"], "-", m["name"], "|", ", ".join(m.get("apps",[]))) for m in d["modes"]]' "$config/modes.json" ;;
  ask)      omarchy-shell petal ask ;;
  search)   omarchy-shell petal search ;;
  settings) omarchy-shell petal settings ;;
  edit)     "${EDITOR:-nvim}" "$config/modes.json" ;;
  restart)
    # With the person's own changes in use, it also checks the dock comes back (after an update that it doesn't,
    # the last Petal that worked is put back).
    if [[ -d ${PETAL_HOME:-$HOME/.local/share/petal}/source/.git ]]; then
      exec python3 "$(dirname "$(readlink -f "$0")")/petal-personal" restart
    fi
    omarchy restart shell ;;
  personal) shift; exec python3 "$(dirname "$(readlink -f "$0")")/petal-personal" "$@" ;;
  update)
    here="$(dirname "$(readlink -f "$0")")"
    case "${2:-}" in
      --check) "$here/../get.sh" --check ;;
      --auto) "$here/../get.sh" --auto ;;
      *) "$here/../get.sh" --update ;;
    esac ;;
  version)  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["version"])' "$(dirname "$(readlink -f "$0")")/../plugin/manifest.json" ;;
  get|set|recipe|suggest|summary)
            exec python3 "$(dirname "$(readlink -f "$0")")/../plugin/mcp/petal-mcp.py" --cli "$@" ;;
  panel)    omarchy-shell petal panel "${2:-}" ;;
  doctor)   shift; exec python3 "$(dirname "$(readlink -f "$0")")/petal-doctor" doctor "$@" ;;
  report)   shift; exec python3 "$(dirname "$(readlink -f "$0")")/petal-doctor" report "$@" ;;
  logs)     quickshell log -n -p /usr/share/omarchy/shell 2>/dev/null | grep -i -E "petal|egesuren|DockWindow|Dock.qml|Brain|Signals|AppSearch|AskBox" | tail -n "${2:-40}" ;;
  *)
    cat <<'HELP'
petal mode <id>   switch this workspace to a mode (waits out a focus countdown)
petal stay        cancel a countdown
petal current     print this workspace's mode
petal modes       list modes and their apps
petal ask         open "✦ Change modes with Claude"
petal search      open the add-apps search
petal settings    open the dock's settings menu
petal edit        edit ~/.config/petal/modes.json
petal restart     restart Omarchy's shell (reloads Petal)
petal update      update Petal from GitHub Releases (--check to only look)
petal version     the installed version
petal logs [n]    recent Petal log lines
petal personal    your own changes to Petal's code, kept through updates (init, status, list, save "…", undo, reset, retry)
petal doctor      check Petal (--fix repairs what it safely can, --json for details)
petal report "…"  tell Petal's maker what went wrong (a GitHub issue; shown to you first)
petal get [key]   all settings and modes, or one setting
petal set <key> <json value>   change a setting (petal set schedule '[{"mode":"building","days":[1,2,3,4,5],"from":"09:00","to":"12:00"}]')
petal recipe export [file]     save your dock to share (modes, apps, look; nothing personal)
petal recipe import <file> [--look]   add a shared dock's modes (shows what changes first)
petal suggest     modes Petal would suggest from your activity
petal summary     last week in your modes
petal panel [page]  open the Petal menu (held, schedule, summary, doctor, recipes, describe)
HELP
    ;;
esac
